# ==========================================
# QueueLess Environment Variables
# ==========================================

# Server Port
PORT=3001
NODE_ENV=development

# Database Connection (Optional)
# If provided, QueueLess connects to standard PostgreSQL (Neon, Supabase, Railway, Replit Postgres, etc.)
# If left empty, QueueLess automatically initializes and persists a local PostgreSQL instance (PGlite) with ZERO setup!
DATABASE_URL=

# JWT Authentication
JWT_SECRET=queueless-super-secret-jwt-key-min-32-chars-2025
JWT_EXPIRES_IN=7d

# Google Gemini API Key
# Optional: If provided, QueueLess calls Gemini 2.5 Flash for waiting-time predictions, status advisories, and anomaly alerts.
# If omitted, QueueLess runs an intelligent statistical M/M/c queueing theory engine automatically.
GEMINI_API_KEY=

# Client API URL (used by Vite frontend during production or custom proxy)
VITE_API_URL=http://localhost:3001
