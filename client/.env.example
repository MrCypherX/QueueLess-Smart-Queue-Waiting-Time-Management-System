# ==========================================
# QueueLess Frontend Client Environment Variables Example
# ==========================================

# Backend API Base URL
# - In local development: http://localhost:3001 (or leave blank to use the Vite dev server proxy configured in vite.config.ts)
# - In production: URL of your deployed backend API (e.g. https://api.queueless.io)
VITE_API_URL=http://localhost:3001
