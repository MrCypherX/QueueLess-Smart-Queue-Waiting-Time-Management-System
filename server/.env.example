# ==========================================
# QueueLess Backend Server Environment Variables Example
# ==========================================

# Server Port and Environment
PORT=3001
NODE_ENV=development

# Database Connection (Optional)
# If left blank, QueueLess automatically initializes and persists an embedded PostgreSQL instance (PGlite) in server/data/queueless-pg
# If provided, QueueLess connects to external PostgreSQL (e.g. Neon, Supabase, Railway, RDS, etc.)
# DATABASE_URL=postgresql://username:password@localhost:5432/queueless
DATABASE_URL=

# JWT Authentication
JWT_SECRET=queueless-super-secret-jwt-key-min-32-chars-2025
JWT_EXPIRES_IN=7d

# Google Gemini API Key (Optional)
# If provided, QueueLess calls Gemini 2.5 Flash for waiting-time predictions, status advisories, and anomaly alerts.
# If omitted, QueueLess runs an intelligent statistical M/M/c queueing theory engine automatically.
GEMINI_API_KEY=
